enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  HEALTH_CHECK
  VACCINATION
  TELECONSULTATION
  EMERGENCY
  OTHER
}

enum AppointmentVisitType {
  NEW
  FOLLOW_UP
  REVIEW
}

enum AppointmentPriority {
  NORMAL
  URGENT
  EMERGENCY
}

model Appointment {
  id           String @id @default(uuid()) @db.Uuid
